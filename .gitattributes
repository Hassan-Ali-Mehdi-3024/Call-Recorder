# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts should always use CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.so binary
*.apk binary
*.ap_ binary
*.dex binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
